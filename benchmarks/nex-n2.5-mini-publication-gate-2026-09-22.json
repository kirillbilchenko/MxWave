  "decision": {
    "classification": "mixed_not_publication_candidate",
    "upload_authorized": false,
    "summary": "The MxWave MSE artifact is a credible local Pareto experiment, but it does not clear the conservative publication gate. It is 4.21% smaller than the public NVFP4 control, has 1.43% lower paired PPL, and is modestly faster in decode. However, the frozen task screen is two cases lower, exact teacher top-1 agreement is two contexts lower, the relative forward-KL interval includes a 6.66% regression, and the two fixed KL halves disagree. Long-prefill TTFT is also about 8.47% slower.",
    "allowed_claim": "interesting workload-dependent trade-off; not a generally better quantization",
    "disallowed_claims": [
      "better overall model quality than BF16 or public NVFP4",
      "statistically established teacher-KL superiority",
      "universally faster serving",
      "publication-ready replacement for the public NVFP4 artifact"
    ]
  },
