FROM vllm/vllm-openai:v0.29.0@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1

# Runtime-only overlay of vllm-project/vllm#57135 onto the exact v0.29.0
# source revision used by the base image.  The source tree supplied as the
# build context must be vLLM commit 98dff2a with Xing4 commit 25aa52a
# cherry-picked on top.
COPY vllm/config/speculative.py /usr/local/lib/python3.12/dist-packages/vllm/config/speculative.py
COPY vllm/model_executor/models/registry.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/registry.py
COPY vllm/model_executor/models/xing4_0.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/xing4_0.py
COPY vllm/reasoning/__init__.py /usr/local/lib/python3.12/dist-packages/vllm/reasoning/__init__.py
COPY vllm/reasoning/xing4_0_reasoning_parser.py /usr/local/lib/python3.12/dist-packages/vllm/reasoning/xing4_0_reasoning_parser.py
COPY vllm/tool_parsers/__init__.py /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/__init__.py
COPY vllm/tool_parsers/xing4_0_tool_parser.py /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/xing4_0_tool_parser.py
COPY vllm/transformers_utils/config.py /usr/local/lib/python3.12/dist-packages/vllm/transformers_utils/config.py
COPY vllm/transformers_utils/model_arch_config_convertor.py /usr/local/lib/python3.12/dist-packages/vllm/transformers_utils/model_arch_config_convertor.py

LABEL org.opencontainers.image.title="vLLM 0.29.0 Xing4 experimental overlay" \
      org.opencontainers.image.revision="25aa52a29131753c10e56528d3fa0c4464cead63" \
      org.opencontainers.image.source="https://github.com/vllm-project/vllm/pull/57135"
